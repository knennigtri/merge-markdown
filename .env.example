# Example environment variables for merge-markdown development
# Copy this to .env and adjust for your needs

# Development Mode
# Set NODE_ENV=dev to enable development mode across the entire application
# - Uses src/ instead of dist/ (uncompiled source code)
# - Docker uses local source code instead of npm registry version
# Set to 'production' or leave unset for production mode (uses dist/ and npm registry)
NODE_ENV=production

# Optional: Enable debug logging
# Uncomment to see detailed operations
# DEBUG=docker
# DEBUG=docker:paths
# DEBUG=pandoc
# DEBUG=pdf
# DEBUG=*
